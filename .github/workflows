name: Java CI with Gradle

on:
  push:
    branches:
      - main        # Trigger the action on push to the 'main' branch (or adjust to your branch)]
      - workflow-testing
  pull_request:
    branches:
      - main        # Trigger on pull requests to 'main' (adjust as needed)
      

jobs:
  build:
    runs-on: ubuntu-latest  # Use the latest Ubuntu runner

    steps:
    - name: Checkout repository
      uses: actions/checkout@v2

    - name: Set up JDK 11
      uses: actions/setup-java@v2
      with:
        java-version: '11'  # Specify the JDK version you are using

    - name: Cache Gradle dependencies
      uses: actions/cache@v2
      with:
        path: ~/.gradle/caches
        key: ${{ runner.os }}-gradle-${{ hashFiles('**/*.gradle*', '**/gradle-wrapper.properties') }}
        restore-keys: |
          ${{ runner.os }}-gradle-

    - name: Build with Gradle
      run: ./gradlew build  # Runs Gradle to build your project